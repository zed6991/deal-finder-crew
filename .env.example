# Copy to .env and fill in.

# Google search results (shopping + web). Free tier at https://serper.dev
SERPER_API_KEY=

# The model the agents use. Any CrewAI/LiteLLM model string works, e.g.
#   openai/gpt-4o-mini, anthropic/claude-sonnet-5, gemini/gemini-2.5-flash, ollama/llama3.1
MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
