# Everything is optional. Deal Finder works with no keys at all.

# Read free-text briefs with Claude (one small call per new brief, cached).
# ANTHROPIC_API_KEY=
# Or reach Claude through OpenRouter (https://openrouter.ai/keys) instead:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5
# An OpenRouter key also labels each new product's style once (about US$0.0001
# each, capped per day). Unlabelled items use the free rules.
# DEAL_FINDER_LABEL_MODEL=anthropic/claude-haiku-5.5
# DEAL_FINDER_LABEL_CAP=3000
# DEAL_FINDER_MODEL=claude-opus-5   # claude-haiku-4-5 costs about a fifth as much

# Search THE ICONIC, David Jones and Country Road through Serper (https://serper.dev,
# 2,500 free searches, then about A$0.002 each). Capped per day:
# SERPER_API_KEY=
# DEAL_FINDER_SEARCH_CAP=25

# Where the data lives. Locally a SQLite file; set DATABASE_URL to use Postgres
# (Vercel + Neon sets it for you).
# DEAL_FINDER_DB=data/deals.db
# DATABASE_URL=postgresql://user:pass@host/db

# Hosting only: the sign-in password, and the secret Vercel Cron sends.
# APP_PASSWORD=
# CRON_SECRET=
